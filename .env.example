# .env.example — copy to .env and fill in. .env is gitignored.
#
#   cp .env.example .env
#
# main.py reads these from the environment; it does not parse .env itself.
# Either `export $(cat .env | xargs)` or use your shell's dotenv support.
#
# NOTHING HERE IS REQUIRED. With a local model server (see below) you need
# no key at all.

# ---------------------------------------------------------------------------
# Provider presets: --provider openai|ollama|lmstudio|llamacpp|vllm|
#                   openrouter|groq|together|deepseek|custom
# Set G1_PROVIDER, or pass --provider on the command line.
# ---------------------------------------------------------------------------

# --- Option A: local model, no API key ------------------------------------
G1_PROVIDER=ollama
# Models are auto-detected from the server. Pin them if you want to:
# G1_PRIMARY_MODEL=qwen2.5-coder:7b
# G1_COMPRESSOR_MODEL=qwen2.5-coder:7b

# --- Option B: OpenAI (cloud) ----------------------------------------------
# G1_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# G1_PRIMARY_MODEL=gpt-4o-mini
# G1_COMPRESSOR_MODEL=gpt-4o-mini

# --- Option C: any other OpenAI-compatible server --------------------------
# Set the base URL directly; nothing else is vendor-specific.
# OPENAI_BASE_URL=http://localhost:8080/v1
# OPENAI_API_KEY=anything          # local servers usually ignore this
# OPENAI_MODEL=<model-name>

# --- Option D: other hosted providers --------------------------------------
# G1_PROVIDER=openrouter   -> OPENROUTER_API_KEY
# G1_PROVIDER=groq         -> GROQ_API_KEY
# G1_PROVIDER=together     -> TOGETHER_API_KEY
# G1_PROVIDER=deepseek     -> DEEPSEEK_API_KEY

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------

# Hard cap on words rendered to the lenses (physical limit, applied locally
# as a backstop even if the model ignores its instructions).
# G1_MAX_DISPLAY_WORDS=25

# Per-request timeout in seconds. The BLE heartbeat runs independently, so a
# slow call never drops the glasses connection.
# G1_LLM_TIMEOUT=30

# Retries on transient API errors.
# G1_LLM_RETRIES=2
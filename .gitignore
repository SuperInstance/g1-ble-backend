# Python
__pycache__/
*.py[cod]
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / tooling
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets — never commit real credentials. .env.example IS committed.
.env
.env.*
!.env.example

# Local capture artifacts
*.log
capture/
# .capture_keep/ is a byte-identical local copy of the captures that live in
# /mnt/c/proart_capture/ (empty1.nv12 here is sha256 da348ccaf08c030de...,
# the same file). It exists so the scripts have a local path to read, and
# it is 91 MB of raw camera data. The canonical capture location is
# outside version control and stays there.
.capture_keep/

# Local SQLite ledgers. The schema is in documents/09-schema.sql and the
# code that creates them is in memory.py, so the databases themselves are
# runtime state, never source. experiments/playtest.py writes one next to
# itself unless told otherwise.
*.db
*.db-journal
*.db-wal
*.db-shm